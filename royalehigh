                local t = i / steps
                local currentX = startX + ((endX - startX) * t)
                local currentY = startY + ((endY - startY) * t)
                local wobble = math.sin(t * math.pi) * math.random(-2, 2)
                VirtualInputManager:SendMouseMoveEvent(currentX + wobble, currentY + wobble, game)
                task.wait(math.random(1, 4) / 100)
            end
            VirtualInputManager:SendMouseButtonEvent(endX, endY, 0, false, game, 1)
            task.wait(math.random(6, 15) / 100) 
