                    local char = string.sub(wordToDraw, i, i)
                    local humanSize = baseSize + math.random(-5, 6)
                    local humanX = startX + ((i - 1) * baseSpacing) + math.random(-4, 7)
                    local humanY = startY + math.random(-6, 6)

