-- Function para mag-send sa Discord kapag walang nahanap sa database
local function sendToDiscord(unknownId)
    if loggedIDs[unknownId] then return end 
    
    local httpRequest = (syn and syn.request) or (http and http.request) or http_request or request or HttpPost
    
    if httpRequest then
        local data = {
            ["content"] = "🚨 **New Captcha ID Found!**\nPlayer: `" .. LocalPlayer.Name .. "`\nUnknown ID: `" .. unknownId .. "`\n*Please check what image this is and add it to the database.*"
        }
        
        local success, err = pcall(function()
            httpRequest({
                Url = WEBHOOK_URL,
                Method = "POST",
                Headers = {
                    ["Content-Type"] = "application/json"
                },
                Body = HttpService:JSONEncode(data)
            })
        end)
        
        if success then
            print("[Auto-Captcha] Successfully sent Unknown ID (" .. unknownId .. ") to Discord!")
            loggedIDs[unknownId] = true 
        else
            warn("[Auto-Captcha] Failed to send webhook: " .. tostring(err))
        end
    else
        warn("[Auto-Captcha] Your executor does not support HTTP requests. Cannot send to Discord.")
    end
end

-- Kunin ang ID ng main image na pinapahanap sa Captcha
local function getTargetId()
    local topCard = LocalPlayer.PlayerGui:FindFirstChild("CardCaptchaGame")
    if topCard and topCard:FindFirstChild("CaptchaGame") and topCard.CaptchaGame.Top.Card then
        local imageString = topCard.CaptchaGame.Top.Card.Image
        local extractedId = string.match(imageString, "id=(%d+)")
        return extractedId
    end
    return nil
end

-- I-scan ang database natin
local function findCorrectButton(targetId)
    for buttonNum, ids in pairs(captchaDatabase) do
        for _, id in ipairs(ids) do
            if id == targetId then
                return buttonNum
            end
        end
    end
    return nil
end

-- Pindutin ang button (1-15) kung nahanap sa database
local function clickButton(buttonNum)
    local buttonPath = LocalPlayer.PlayerGui.CardCaptchaGame.CaptchaGame.Bottom.Buttons[tostring(buttonNum)]
    
    if buttonPath then
        print("[Auto-Captcha] Pinindot ang Button " .. buttonNum)
        if getconnections then
            for _, connection in pairs(getconnections(buttonPath.MouseButton1Click)) do
                connection:Fire()
            end
        else
            warn("[Auto-Captcha] Walang getconnections na available.")
        end
    end
end

