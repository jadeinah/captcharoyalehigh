local function solveCaptcha(captchaGui)
    if captchaGui and captchaGui.Enabled then
        print("[Auto-Captcha] Captcha Detected! Solving...")
        task.wait(1) 
        
        local targetId = getTargetId()
        if targetId then
            local correctButton = findCorrectButton(targetId)
            
            if correctButton then
                clickButton(correctButton)
            else
                warn("[Auto-Captcha] Hindi mahanap yung ID na " .. targetId .. " sa database.")
                sendToDiscord(targetId)
            end
        end
    end
end

local function hookCaptcha(captchaGui)
    captchaGui:GetPropertyChangedSignal("Enabled"):Connect(function()
        solveCaptcha(captchaGui)
    end)
    solveCaptcha(captchaGui)
end

local PlayerGui = LocalPlayer:WaitForChild("PlayerGui")
